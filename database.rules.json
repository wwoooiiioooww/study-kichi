{
  "rules": {
    ".read": false,
    ".write": false,

    "families": {
      "$fid": {
        ".read": "auth != null && $fid.matches(/^[a-z2-7]{26}$/)",
        ".write": "auth != null && $fid.matches(/^[a-z2-7]{26}$/)",
        ".validate": "newData.hasChildren(['state','meta'])",

        "state": {
          ".validate": "newData.isString() && newData.val().length <= 1000000"
        },
        "meta": {
          "rev":       { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "updatedAt": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "$other":    { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    },

    "feedback": {
      ".read": false,
      "$id": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['text','ts'])",
        "text": { ".validate": "newData.isString() && newData.val().length <= 2000" },
        "ts":   { ".validate": "newData.isNumber()" },
        "ver":  { ".validate": "newData.isString() && newData.val().length <= 20" },
        "name": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "$other": { ".validate": false }
      }
    }
  }
}
